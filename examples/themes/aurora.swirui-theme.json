{
  "format": "swirui.theme-package",
  "format_version": 1,
  "name": "Aurora",
  "version": "1.0.0",
  "author": "Swir",
  "description": "Deep teal surfaces and a quiet daylight workspace.",
  "default_theme": "night",
  "themes": {
    "night": {
      "palette": {
        "canvas": "#07191E",
        "surface": "#0D242B",
        "raised": "#14323A",
        "hover": "#1B434B",
        "pressed": "#225762",
        "border": "#31505A",
        "focus": "#A3F6E5",
        "accent": "#76E4CF",
        "accent_hover": "#A3F6E5",
        "accent_pressed": "#50BFAE",
        "on_accent": "#062B25",
        "text": "#EAF9F6",
        "muted": "#9FBFBE",
        "disabled": "#1A3339",
        "disabled_text": "#758F92",
        "selection": "#23574F",
        "success": "#8FE5B5",
        "warning": "#F4CF86",
        "error": "#FF99AC"
