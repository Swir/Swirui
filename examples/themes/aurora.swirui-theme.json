        "accent_hover": "#08786B",
        "accent_pressed": "#064D46",
        "on_accent": "#FFFFFF",
        "text": "#102C27",
        "muted": "#46655F",
        "disabled": "#DAE8E2",
        "disabled_text": "#728A82",
        "selection": "#BDEBDD",
        "success": "#146F52",
        "warning": "#8A5900",
        "error": "#BC304D"
      },
      "font_family": "Segoe UI",
      "control_radius": 8.0,
      "motion_duration": 0.16,
      "reduced_motion": false,
      "monospace_family": "Cascadia Mono"
    }
  }
